}

Table permitted_urls {
  id bigint [pk, increment]
  url text [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table professors {
  user_id bigint [pk]
  professor_code text [unique]
  recovery_secret text
  created_by bigint
  phone text
  position text
}

Table question_ai_review {
  assignment_id bigint [not null]
  question_id bigint [not null]
  percent_correct smallint [not null]
  reasoning text [not null]
  created_at timestamptz [not null, default: `now()`]
  writing_notes text

  Indexes {
    (assignment_id, question_id) [pk]
  }
}

Table question_assignment {
  assignment_id bigint [not null]
  question_id bigint [not null]
  answer text [not null]
  typing_duration integer [not null, default: 0]
  typing_duration_unit type_time_unit [not null, default: 'seconds']
  text_typed integer [not null, default: 0]
  text_edited integer [not null, default: 0]
  text_pasted integer [not null, default: 0]
  last_synced_at timestamptz
  started_at timestamptz
  answered_at timestamptz
  position integer [not null, default: 0]
  marks_awarded integer [not null, default: 0]
  text_deleted integer [not null, default: 0]
  freeze_count integer [not null, default: 0]
  longest_freeze integer [not null, default: 0]
  paste_events integer [not null, default: 0]

  Indexes {
    (assignment_id, question_id) [pk]
  }
}

Table question_assignment_option {
  assignment_id bigint [not null]
  question_id bigint [not null]
  option_id bigint [not null]

  Indexes {
    (assignment_id, question_id, option_id) [pk]
  }
}

Table question_options {
  id bigint [pk, increment]
  question_id bigint [not null]
  option_text text [not null]
  is_correct boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  reason text
}

Table questions {
  id bigint [pk, increment]
  title varchar [not null]
  question_type type_question_type [not null, default: 'multiple_choice']
  question text [not null, default: '']
  expected_duration integer [not null, default: 0]
  expected_duration_unit type_time_unit [not null, default: 'seconds']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  reason text
  created_by bigint
  model_answers text[]
}

Table snapshots {
  id bigint [pk, increment]
  url text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  reason text
  label text
}

Table student_assignment {
  student_id bigint [not null]
  assignment_id bigint [not null]
  exam_id bigint [not null]

  Indexes {
    (student_id, assignment_id) [pk]
    (student_id, exam_id) [unique]
  }
}

Table student_permitted_app {
  student_id bigint [not null]
  permitted_app_id bigint [not null]

  Indexes {
    (student_id, permitted_app_id) [pk]
  }
}

Table student_permitted_url {
  student_id bigint [not null]
  permitted_url_id bigint [not null]

  Indexes {
    (student_id, permitted_url_id) [pk]
  }
}

Table students {
  user_id bigint [pk]
  student_code text [unique]
  recovery_secret text
  created_by bigint
  phone text
  parent_phone text
  parent_relation text
  profile_photo_url text
  age smallint
  id_number text [unique]
}

Table tokens {
  id bigint [pk, increment]
  token text [not null]
  token_type type_token_type [not null]
  expires_at timestamptz [not null]
  revoked boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table users {
  id bigint [pk, increment]
  first_name varchar [not null]
  last_name varchar
  email text [not null, unique]
  password text [not null]
  is_verified boolean [not null, default: false]
  active_status type_user_active_status [not null, default: 'pending']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  reason text
}

Table users_tokens {
  user_id bigint [not null]
  token_id bigint [not null]

  Indexes {
    (user_id, token_id) [pk]
  }
}

Table video_recordings {
  id bigint [pk, increment]
  url text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  reason text
  label text
}

