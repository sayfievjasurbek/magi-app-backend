  }
}

Table exam_question {
  exam_id bigint [not null]
  question_id bigint [not null]
  position integer [not null, default: 0]
  marks integer [not null, default: 1]

  Indexes {
    (exam_id, question_id) [pk]
    (exam_id, position) [unique]
  }
}

Table exam_student {
  exam_id bigint [not null]
  student_id bigint [not null]

  Indexes {
    (exam_id, student_id) [pk]
  }
}

Table examiners {
  user_id bigint [pk]
}

Table exams {
  id bigint [pk, increment]
  name varchar [not null]
  shuffle_questions boolean [not null, default: true]
  scheduled_start timestamptz [not null]
  scheduled_end timestamptz [not null]
  status type_exam_status [not null, default: 'scheduled']
  max_marks integer [not null, default: 100]
  passing_marks integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  reason text
  created_by bigint
  kind type_exam_kind [not null, default: 'homework']
}

