Table ai_chat_conversations {
  id bigint [pk, increment]
  professor_id bigint [not null]
  title text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table ai_chat_messages {
  id bigint [pk, increment]
  conversation_id bigint [not null]
  role text [not null]
  content text [not null]
  actions jsonb
  file_name text
  created_at timestamptz [not null, default: `now()`]
  model_content text
}

Table assignment_ai_review {
  assignment_id bigint [pk]
  cheating_likelihood type_ai_likelihood [not null]
  cheating_reasoning text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table assignment_audio_recording {
  assignment_id bigint [not null]
  audio_recording_id bigint [not null]

  Indexes {
    (assignment_id, audio_recording_id) [pk]
  }
}

Table assignment_face_snapshot {
  assignment_id bigint [not null]
  face_snapshot_id bigint [not null]

  Indexes {
    (assignment_id, face_snapshot_id) [pk]
  }
}

Table assignment_panoramic_view {
  assignment_id bigint [not null]
  panoramic_view_id bigint [not null]

  Indexes {
    (assignment_id, panoramic_view_id) [pk]
  }
}

Table assignment_permitted_app {
  assignment_id bigint [not null]
  permitted_app_id bigint [not null]

  Indexes {
    (assignment_id, permitted_app_id) [pk]
  }
}

Table assignment_permitted_url {
  assignment_id bigint [not null]
  permitted_url_id bigint [not null]

  Indexes {
    (assignment_id, permitted_url_id) [pk]
  }
}

Table assignment_snapshot {
  assignment_id bigint [not null]
  snapshot_id bigint [not null]

  Indexes {
    (assignment_id, snapshot_id) [pk]
  }
}

Table assignment_video_recording {
  assignment_id bigint [not null]
  video_recording_id bigint [not null]

  Indexes {
    (assignment_id, video_recording_id) [pk]
  }
}

Table assignments {
  id bigint [pk, increment]
  exam_id bigint [not null]
  session_duration integer [not null, default: 0]
  session_duration_unit type_time_unit [not null, default: 'seconds']
  started_at timestamptz
  submitted_at timestamptz
  auto_submitted boolean [not null, default: false]
  status type_assignment_status [not null, default: 'pending']
  score integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  reason text
  feedback text
  cheating_disclosed boolean [not null, default: false]
  typing_timeline jsonb [not null, default: '[]']
  unlimited_time boolean [not null, default: false]

  Indexes {
    (id, exam_id) [unique]
  }
}

Table attendance {
  id bigint [pk, increment]
  module_id bigint [not null]
  student_id bigint [not null]
  date date [not null]
  present boolean [not null]
  recorded_by bigint [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (module_id, student_id, date) [unique]
  }
}

Table audio_recordings {
  id bigint [pk, increment]
  url text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  reason text
}

Table cheating_reason {
  assignment_id bigint [not null]
  cheating_id bigint [not null]

  Indexes {
    (assignment_id, cheating_id) [pk]
  }
}

Table cheatings {
  id bigint [pk, increment]
  name type_cheating_types [not null]
  explanation text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  reason text
}

Table email_logs {
  user_id bigint [not null]
  email_usage_case bigint [not null]
  sent_at timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, email_usage_case, sent_at) [pk]
  }
}

Table email_rules {
  id bigint [pk, increment]
  email_usage_case type_email_usage_case [not null, unique]
  max_per_day integer [not null, default: 3]
  cooldown_duration integer [not null, default: 60]
  cooldown_unit type_time_unit [not null, default: 'minutes']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table email_usage {
  user_id bigint [not null]
  email_usage_case bigint [not null]
  last_sent timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, email_usage_case) [pk]
  }
}

Table events {
  id bigint [pk, increment]
  name type_exam_event [not null]
  description text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
  reason text
}

