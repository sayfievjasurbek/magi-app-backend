PORT=
NODE_ENV=
CLIENT_URL=

# Supabase project URL and the service_role key - storage only now (proctoring/submissions
# buckets, lib/storage.ts). The actual Postgres data moved off Supabase; see DATABASE_DIRECT_URL.
DATABASE_URL=
DATABASE_KEY=
# Postgres connection string the app actually queries through (lib/db.ts, lib/pg-query-builder.ts)
# and that `npm run migrate` applies migrations to - a Railway Postgres in the same project as this
# server, not Supabase, so there's no cross-provider network hop on every query.
DATABASE_DIRECT_URL=

# In production at least 32 random characters (openssl rand -hex 32), the server refuses to start otherwise
JWT_SECRET=

# Mailtrap
EMAIL_TOKEN=
SENDER_EMAIL=

# Optional - AI-assisted grading (features/ai, POST /api/assignments/{id}/ai-review) and the Magi
# AI chat assistant (POST /api/ai/chat) both stay off, reporting themselves unconfigured
# (GET /api/ai/status), until this is set
OPENAI_API_KEY=
# The grading model - defaults to gpt-4o-mini (a high-volume, per-answer call) if unset
OPENAI_MODEL=
# The Magi AI chat assistant's model - defaults to gpt-4o (a lower-volume, higher-stakes chat) if unset
OPENAI_ASSISTANT_MODEL=
