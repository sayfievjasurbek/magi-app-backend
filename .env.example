PORT=
NODE_ENV=
CLIENT_URL=

# Supabase project URL and the service_role key (RLS is enabled on all tables)
DATABASE_URL=
DATABASE_KEY=
# Direct Postgres connection string, only used by `npm run migrate`
DATABASE_DIRECT_URL=

# In production at least 32 random characters (openssl rand -hex 32), the server refuses to start otherwise
JWT_SECRET=

# Mailtrap
EMAIL_TOKEN=
SENDER_EMAIL=
